{
  "name": "yesplaymusic",
  "version": "0.1.1-alpha.6",
  "private": true,
  "description": "A third party music player for Netease Music",
  "author": "qier222<qier222@outlook.com>",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "serve": "yarn dev",
    "build": "vite build",
    "postbuild": "node scripts/build-tui-entry.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "yarn lint && yarn test && yarn build",
    "lint": "eslint \"src/**/*.{js,vue}\"",
    "tui": "node scripts/yesplaymusic-tui.mjs",
    "tui:build": "node scripts/build-tui-entry.mjs",
    "tui:exe": "node scripts/build-tui-exe.mjs",
    "electron:build": "yarn desktop:build",
    "electron:build-all": "electron-vite build && yarn tui:build && yarn tui:exe && electron-builder -mwl",
    "electron:build-mac": "electron-vite build && yarn tui:build && electron-builder -m",
    "electron:build-win": "electron-vite build && yarn tui:build && yarn tui:exe && electron-builder -w",
    "electron:build-win-installer": "electron-vite build && yarn tui:build && yarn tui:exe && electron-builder --win nsis --x64 --publish never",
    "electron:build-win-installer-fast": "electron-vite build && yarn tui:build && yarn tui:exe && electron-builder --win nsis --x64 --publish never --config.compression=store",
    "electron:build-win-portable": "electron-vite build && yarn tui:build && yarn tui:exe && electron-builder -w portable",
    "electron:build-linux": "electron-vite build && yarn tui:build && yarn tui:exe && electron-builder -l",
    "electron:serve": "yarn desktop:dev",
    "electron:repair": "node scripts/repair-electron.mjs",
    "electron:repair-and-serve": "yarn electron:repair && yarn desktop:dev",
    "electron:publish": "electron-vite build && yarn tui:build && yarn tui:exe && electron-builder -mwl -p always",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "prettier": "npx prettier --write ./src",
    "netease_api:run": "npx @neteasecloudmusicapienhanced/api",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "electron-vite build && yarn tui:build && yarn tui:exe && electron-builder",
    "desktop:preview": "electron-vite preview",
    "electron:build-win-dir": "electron-vite build && yarn tui:build && yarn tui:exe && electron-builder -w --dir"
  },
  "main": "out/main/index.js",
  "bin": {
    "yesplaymusic-tui": "out/tui/yesplaymusic-tui.mjs"
  },
  "build": {
    "appId": "com.github.qier222.yesplaymusic",
    "productName": "YesPlayMusic",
    "copyright": "Copyright © YesPlayMusic",
    "asar": true,
    "files": [
      "out/**",
      "scripts/yesplaymusic-tui.mjs",
      "server/**",
      "admin/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "axuanran",
        "repo": "YesPlayMusic",
        "vPrefixedTagName": true,
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist_electron"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
      "category": "public.app-category.music",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "extraResources": [
        {
          "from": "dist_tui",
          "to": "tui",
          "filter": [
            "**/*",
            "!**/.build/**"
          ]
        }
      ],
      "publish": [
        "github"
      ]
    },
    "linux": {
      "executableName": "yesplaymusic",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "armv7l",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Music",
      "icon": "build/icons",
      "extraResources": [
        {
          "from": "dist_tui",
          "to": "tui",
          "filter": [
            "**/*",
            "!**/.build/**"
          ]
        }
      ]
    },
    "dmg": {
      "icon": "build/icons/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": true
    },
    "portable": {
      "artifactName": "yesplaymusic.exe"
    }
  },
  "engines": {
    "node": ">=22 <26"
  },
  "dependencies": {
    "@akabeko/music-metadata-editor": "^1.0.1",
    "@jellybrick/mpris-service": "^2.2.0",
    "@neteasecloudmusicapienhanced/api": "^4.36.1",
    "@unblockneteasemusic/rust-napi": "^0.4.0",
    "@vscode/codicons": "^0.0.45",
    "axios": "^1.18.1",
    "change-case": "^5.4.4",
    "cli-color": "^2.0.4",
    "color": "^5.0.3",
    "core-js": "^3.49.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "dexie": "^4.4.4",
    "discord-rich-presence": "^0.0.8",
    "electron-context-menu": "^4.1.2",
    "electron-debug": "^4.1.0",
    "electron-devtools-installer": "^4.0",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-http-proxy": "^2.1.2",
    "extract-zip": "^2.0.1",
    "js-cookie": "^3.0.8",
    "jsbi": "^4.3.2",
    "lodash": "^4.18.1",
    "md5": "^2.3.0",
    "music-metadata": "^11.13.0",
    "node-vibrant": "^4.0.4",
    "nprogress": "^0.2.0",
    "pac-proxy-agent": "^9.1.0",
    "plyr": "^3.8.4",
    "qrcode": "^1.5.4",
    "register-service-worker": "^1.7.2",
    "tunnel": "^0.0.6",
    "vue": "^3.5.39",
    "vue-clipboard2": "^0.3.1",
    "vue-gtag-next": "^1.14.0",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.5.1",
    "vue-slider-component": "4.1.0-beta.7",
    "vuex": "^4.1.0",
    "x11": "^2.3.0",
    "xstate": "^5.32.2"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/helper-compilation-targets": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/cli-plugin-babel": "~5.0.9",
    "@vue/cli-plugin-eslint": "~5.0.9",
    "@vue/cli-plugin-pwa": "~5.0.9",
    "@vue/cli-plugin-vuex": "~5.0.9",
    "@vue/cli-service": "~5.0.9",
    "@vue/compiler-sfc": "^3.5.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "postject": "^1.0.0-alpha.6",
    "prettier": "3.8.4",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "svg-sprite-loader": "^6.0.11",
    "vite": "7.3.6",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "webpack": "^5.107.2"
  },
  "resolutions": {
    "@babel/core": "7.28.5",
    "@babel/helper-compilation-targets": "^7.29.7",
    "**/@achrinza/node-ipc": "9.2.10"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npm run prettier"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "core-js@3.49.0": true
  },
  "releaseVersion": "0.1.1-alpha.6"
}
