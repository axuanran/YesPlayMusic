    "fallbackToLegacy": true,
    "unblock": {
      "enabled": true,
      "source": "ytdl, bilibili, pyncm, kugou",
      "enableFlac": false,
      "proxyUri": "",
      "searchMode": "fast-first",
      "jooxCookie": "",
      "qqCookie": "",
      "ytDlExe": ""
    }
  }
}
